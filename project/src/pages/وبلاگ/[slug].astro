---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PhoneCTA from '../../components/PhoneCTA.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as Props;
const { Content } = await post.render();

const title = `${post.data.title} | وبلاگ تعمیر پاکدشت`;
const description = post.data.description;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "dateModified": post.data.pubDate.toISOString(),
    "author": { "@type": "Organization", "name": post.data.author },
    "publisher": { "@type": "Organization", "name": "تعمیر پاکدشت" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://tamirpakdasht.ir/" },
      { "@type": "ListItem", "position": 2, "name": "وبلاگ", "item": "https://tamirpakdasht.ir/وبلاگ" },
      { "@type": "ListItem", "position": 3, "name": post.data.title },
    ]
  }
];
---

<Layout title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[
      { name: 'وبلاگ', url: '/وبلاگ' },
      { name: post.data.title },
    ]} />

    <p class="text-sm text-brand-600 font-medium mb-2">{post.data.category}</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 leading-tight">{post.data.title}</h1>
    <p class="text-gray-500 text-sm mb-8">{post.data.pubDate.toLocaleDateString('fa-IR')}</p>

    <article class="prose prose-rtl max-w-none">
      <Content />
    </article>

    <PhoneCTA title="سوالی دارید؟ تماس بگیرید" subtitle="مدیریت: آقای خسروبیگی — خدمات ۲۴ ساعته" />
  </div>
</Layout>
