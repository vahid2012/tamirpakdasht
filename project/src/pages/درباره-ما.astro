---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PhoneCTA from '../components/PhoneCTA.astro';

const title = 'درباره تعمیر پاکدشت | تعمیرات و امداد خودرو';
const description = 'درباره تعمیر پاکدشت — مرکز تخصصی تعمیر لوازم خانگی و امداد خودرو در پاکدشت، قرچک، ورامین، پیشوا و تهران با مدیریت آقای خسروبیگی. تماس: ۰۹۰۳۲۴۸۶۰۷۳';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "درباره تعمیر پاکدشت",
    "url": "https://tamirpakdasht.ir/درباره-ما",
  },
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "تعمیر پاکدشت",
    "telephone": "+989032486073",
    "image": "https://tamirpakdasht.ir/og-image.svg",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "پاکدشت",
      "addressRegion": "تهران",
      "addressCountry": "IR"
    },
    "openingHours": "Mo-Su 00:00-23:59",
    "founder": {
      "@type": "Person",
      "name": "آقای خسروبیگی"
    },
    "areaServed": [
      { "@type": "City", "name": "پاکدشت" },
      { "@type": "City", "name": "قرچک" },
      { "@type": "City", "name": "ورامین" },
      { "@type": "City", "name": "پیشوا" },
      { "@type": "City", "name": "تهران" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "خانه", "item": "https://tamirpakdasht.ir/" },
      { "@type": "ListItem", "position": 2, "name": "درباره ما", "item": "https://tamirpakdasht.ir/درباره-ما" }
    ]
  }
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs items={[{ name: 'درباره ما' }]} />

    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6 leading-tight">
      درباره تامیرپاکدشت | تعمیرات لوازم خانگی و امداد خودرو در پاکدشت
    </h1>

    <p class="text-lg text-gray-700 leading-relaxed mb-8 bg-brand-50 border-r-4 border-brand-500 p-4 rounded-lg">
      تعمیر پاکدشت با مدیریت آقای خسروبیگی و بیش از ۱۵ سال تجربه، مرکز تخصصی تعمیر لوازم خانگی و امداد خودرو در پاکدشت و شهرهای اطراف است. برای تماس با ما:<a href="tel:09032486073" class="text-brand-600 font-bold" dir="ltr">09032486073</a>
    </p>

    <section class="prose prose-rtl max-w-none mb-10">
      <h2>داستان ما</h2>
      <p>
        تعمیر پاکدشت داستان فعالیت یک تیم متخصص و پرتلاش است که فعالیت خود را بیش از ۱۵ سال پیش در شهر پاکدشت آغاز کرد. در ابتدا، این مجموعه با تیمی کوچک از تکنسین‌های تعمیر لوازم خانگی کار خود را شروع کرد و هدف آن ارائه خدمات تعمیری سریع و قابل اعتماد به ساکنان پاکدشت بود. با گذشت زمان و افزایش رضایت مشتریان، دامنه فعالیت ما از پاکدشت به شهرهای اطراف نیز گسترش یافت.
      </p>
      <p>
        امروزه تعمیر پاکدشت با پوشش کامل شهرهای پاکدشت، قرچک، ورامین و پیشوا در زمینه تعمیر لوازم خانگی و خدمات امداد خودرو، یکی از معتبرترین مراکز خدمات فنی در منطقه است. ما در این مسیر همواره بر سه اصل کیفیت، سرعت و رضایت مشتری تأکید کرده‌ایم و این رویه باعث رشد و اعتبار مجموعه ما شده است.
      </p>
      <p>
        در طول سال‌های فعالیت، هزاران خانواده در پاکدشت و شهرهای اطرال به خدمات تعمیری ما اعتماد کرده‌اند. از تعمیر یخچال‌های خانگی تا یدک کش خودروهای خراب در جاده‌های بین‌شهری، تیم ما همواره آماده ارائه خدمات بوده است. این تجربه گسترده باعث شده تا امروز با تیمی مجرب و تجهیزات کامل، خدمات متنوعی را به ساکنان منطقه ارائه دهیم.
      </p>
      <p>
        گسترش خدمات ما از تعمیر لوازم خانگی به امداد خودرو نیز بخشی از داستان رشد ماست. با توجه به نیاز ساکنان پاکدشت و شهرهای اطراف به خدمات امداد خودرو سریع و قابل اعتماد، تیم ما با اخذ مجوز رسمی از کانون جهانگردی و اتومبیلرانی، خدمات یدک کش، مکانیک سیار و خودروبر را نیز به مجموعه خدمات خود افزود.
      </p>
    </section>

    <section class="prose prose-rtl max-w-none mb-10">
      <h2>چرا به ما اعتماد کنید؟</h2>
      <p>
        اعتماد مشتریان مهم‌ترین دارایی ماست و ما با رعایت استانداردهای زیر، این اعتماد را حفظ کرده‌ایم:
      </p>
      <ul>
        <li><strong>مجوز رسمی از کانون جهانگردی و اتومبیلرانی:</strong> تمام خدمات امداد خودرو ما با مجوز رسمی از کانون جهانگردی و اتومبیلرانی ارائه می‌شود که نشان‌دهنده قانونی و معتبر بودن فعالیت ماست.</li>
        <li><strong>مدیریت آقای خسروبیگی:</strong> مدیریت مجموعه بر عهده آقای خسروبیگی است که با سال‌ها تجربه در خدمات فنی و امدادی، نظارت مستقیم بر کیفیت همه خدمات دارد.</li>
        <li><strong>پوشش ۲۴ ساعته:</strong> خدمات ما در تمام ساعات شبانه‌روز و در تمام ایام سال ارائه می‌شود. چه در ساعات اوج ترافیک، چه در شب‌هنگام و چه در روزهای تعطیل، تیم ما آماده اعزام است.</li>
        <li><strong>گارانتی خدمات:</strong> تمام خدمات تعمیر لوازم خانگی شامل گارانتی کتبی از ۶ ماه تا ۱۲ ماه بر روی قطعات نصب شده و خدمات انجام شده است.</li>
        <li><strong>قطعات اصل و شرکتی:</strong> ما فقط از قطعات اصل و شرکتی استفاده می‌کنیم و کیفیت تعمیرات را تضمین می‌کنیم.</li>
        <li><strong>هزینه شفاف:</strong> پیش از شروع هرگونه تعمیر یا خدمات، هزینه دقیق به صورت شفاف به شما اعلام می‌شود.</li>
      </ul>
      <p>
        برای تماس و مشاوره رایگان، با شماره <a href="tel:09032486073" dir="ltr">09032486073</a> تماس بگیرید. مدیریت آقای خسروبیگی همواره پاسخگوی سوالات و نظرات شماست.
      </p>
    </section>

    <section class="prose prose-rtl max-w-none mb-10">
      <h2>تیم و تخصص‌ها</h2>
      <p>
        تیم تعمیر پاکدشت از دو بخش تخصصی تشکیل شده است: بخش تعمیر لوازم خانگی و بخش امداد خودرو. هر بخش دارای تکنسین‌ها و متخصصان حرفه‌ای با سال‌ها تجربه در حوزه خود هستند.
      </p>

      <h3>تیم تعمیر لوازم خانگی</h3>
      <p>
        تکنسین‌های تعمیر لوازم خانگی ما در تعمیر انواع دستگاه‌های خانگی تخصص کامل دارند. خدمات این تیم شامل موارد زیر است:
      </p>
      <ul>
        <li><a href="/تعمیر-یخچال">تعمیر یخچال فریزر</a> — تعمیر انواع خرابی‌های یخچال از سرد نکردن تا برفک زدن و نشتی آب در تمام برندها</li>
        <li><a href="/تعمیر-لباسشویی">تعمیر ماشین لباسشویی</a> — رفع خرابی‌های استارت نخوردن، نشتی آب، لرزش و تخلیه نشدن</li>
        <li><a href="/تعمیر-کولر-گازی">تعمیر کولر گازی</a> — شارژ گاز، تعمیر کمپرسور، سرویس دوره‌ای و رفع نشتی آب</li>
        <li><a href="/تعمیر-پکیج">تعمیر پکیج دیواری</a> — رفع ارور E، گرم نکردن، نشتی گاز و سرویس دوره‌ای</li>
        <li><a href="/تعمیر-اجاق-گاز">تعمیر اجاق گاز</a> — تعمیر شعله، سنسور فر، شمع و سوپاپ در تمام برندها</li>
      </ul>
      <p>
        تکنسین‌های ما در تعمیر تمام برندهای ایرانی و خارجی از جمله اسنوا، پاکشوما، الجی، سامسونگ، بوش، دوو، هایر و امرسان تخصص دارند. برای هر برند کاتالوگ فنی به‌روز در اختیار داریم و تعمیرات با استفاده از قطعات اصل و شرکتی انجام می‌شود.
      </p>

      <h3>تیم امداد خودرو</h3>
      <p>
        تیم امداد خودرو ما با مجوز رسمی از کانون جهانگردی و اتومبیلرانی، خدمات زیر را ارائه می‌دهد:
      </p>
      <ul>
        <li><a href="/یدک-کش">یدک کش</a> — یدک کشی فوری خودروهای سواری، شاسی‌بلند و وانت در تمام ساعات</li>
        <li><a href="/مکانیک-سیار">مکانیک سیار</a> — رفع خرابی‌های موتوری، تعویض روغن و تنظیم موتور در محل</li>
        <li><a href="/خودروبر">خودروبر</a> — حمل خودروهای تصادفی و انتقال بین شهری با خودروبرهای مجهز و بیمه‌شده</li>
      </ul>
      <p>
        تمام خودروهای یدک‌کش و خودروبر ما بیمه‌شده هستند و رانندگان حرفه‌ای با سال‌ها تجربه در حمل خودرو، ایمنی کامل خودروی شما را تضمین می‌کنند.
      </p>
    </section>

    <section class="prose prose-rtl max-w-none mb-10">
      <h2>مناطق تحت پوشش</h2>
      <p>
        خدمات تعمیر پاکدشت در شهرهای زیر با پوشش کامل محلات و جاده‌های اطراف ارائه می‌شود:
      </p>
      <ul>
        <li><strong>پاکدشت</strong> — مرکز اصلی فعالیت ما با پوشش تمام محلات از جمله شهرک قدس، شهرک ولیعصر، کلاله و شریف‌آباد. خدمات تعمیر لوازم خانگی و امداد خودرو با میانگین زمان رسیدن ۲۰ تا ۳۰ دقیقه. <a href="/تعمیر-یخچال-پاکدشت">تعمیر یخچال در پاکدشت</a> یکی از پرتقاضاترین خدمات ماست.</li>
        <li><strong>قرچک</strong> — پوشش کامل محلات از جمله شهرک امام خمینی، شهرک قائم و نظام‌آباد. میانگین زمان رسیدن ۲۵ تا ۳۵ دقیقه. <a href="/تعمیر-لباسشویی-قرچک">تعمیر لباسشویی در قرچک</a> و سایر خدمات تعمیری در دسترس است.</li>
        <li><strong>ورامین</strong> — پوشش محلات از جمله شهرک ولیعصر، شهرک امام و امیریه. میانگین زمان رسیدن ۳۰ تا ۴۰ دقیقه. <a href="/یدک-کش-ورامین">یدک کش در ورامین</a> یکی از خدمات پرتقاضای امداد خودرو در این شهر است.</li>
        <li><strong>پیشوا</strong> — جنوبی‌ترین شهر تحت پوشش با خدمات کامل تعمیر لوازم خانگی و امداد خودرو. میانگین زمان رسیدن ۳۵ تا ۴۵ دقیقه.</li>
        <li><strong>تهران</strong> — پوشش خدمات امداد خودرو شامل یدک کش، مکانیک سیار و خودروبر در تمام مناطق تهران. <a href="/امداد-خودرو-تهران">امداد خودرو در تهران</a> با میانگین زمان رسیدن ۲۰ تا ۴۵ دقیقه بسته به منطقه و ترافیک.</li>
      </ul>
    </section>

    <PhoneCTA title="با ما در تماس باشید" subtitle="مدیریت: آقای خسروبیگی — پوشش ۲۴ ساعته در تمام ایام سال" />
  </div>
</Layout>
