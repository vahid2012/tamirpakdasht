---
import Layout from '../layouts/Layout.astro';
import PhoneCTA from '../components/PhoneCTA.astro';
import { services } from '../data/services';
import { roadsideServices } from '../data/roadside';
import { locations } from '../data/locations';

const title = 'تعمیر پاکدشت | تعمیر لوازم خانگی و امداد خودرو ۲۴ ساعته';
const description = 'تعمیر لوازم خانگی و امداد خودرو در پاکدشت، قرچک، ورامین و پیشوا با گارانتی. تعمیر یخچال، لباسشویی، کولر گازی، پکیج و یدک کش ۲۴ ساعته. تماس: ۰۹۰۳۲۴۸۶۰۷۳';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "تعمیر پاکدشت",
  "image": "https://tamirpakdasht.ir/favicon.svg",
  "telephone": "09032486073",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "پاکدشت",
    "addressRegion": "تهران",
    "addressCountry": "IR"
  },
  "openingHours": "Mo-Su 00:00-23:59",
  "description": "تعمیر لوازم خانگی و امداد خودرو در پاکدشت و شهرهای اطرال با گارانتی و خدمات ۲۴ ساعته.",
  "founder": {
    "@type": "Person",
    "name": "آقای خسروبیگی"
  }
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <section class="bg-gradient-to-l from-brand-700 via-brand-600 to-brand-800 text-white py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-6 leading-tight">
        تعمیر لوازم خانگی و امداد خودرو در پاکدشت
      </h1>
      <p class="text-lg sm:text-xl text-brand-100 mb-8 max-w-3xl mx-auto leading-relaxed">
        مرکز تخصصی تعمیر یخچال، لباسشویی، کولر گازی، پکیج و اجاق گاز به همراه خدمات یدک کش و امداد خودرو ۲۴ ساعته در پاکدشت، قرچک، ورامین و پیشوا.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="tel:09032486073"
          class="inline-flex items-center gap-3 bg-white text-brand-700 font-bold text-lg px-8 py-4 rounded-xl hover:bg-brand-50 transition-colors shadow-lg"
          dir="ltr"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          09032486073
        </a>
        <a href="/تعمیر-لوازم-خانگی" class="inline-flex items-center gap-2 bg-brand-900/50 hover:bg-brand-900 text-white font-semibold px-6 py-4 rounded-xl transition-colors border border-brand-400">
          خدمات تعمیر لوازم خانگی
        </a>
      </div>
      <p class="mt-6 text-brand-200 text-sm">مدیریت: آقای خسروبیگی — پوشش ۲۴ ساعته در تمام ایام سال</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 text-center">خدمات تعمیر لوازم خانگی</h2>
    <p class="text-gray-600 text-center mb-10">تعمیر تخصصی تمام برندها با گارانتی کتبی ۶ تا ۱۲ ماهه</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        services.map((service) => (
          <a href={`/${service.slug}`} class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-brand-300 hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-brand-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-brand-100 transition-colors">
              <span class="text-brand-600 text-2xl font-bold">{service.persianName.charAt(0)}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-brand-600 transition-colors">{service.persianName}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{service.shortDesc}</p>
            <span class="text-sm text-brand-600 font-medium group-hover:text-brand-700">مشاهده خدمات →</span>
          </a>
        ))
      }
    </div>

    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 text-center mt-16">خدمات امداد خودرو</h2>
    <p class="text-gray-600 text-center mb-10">امداد خودرو ۲۴ ساعته با مجوز رسمی از کانون جهانگردی و اتومبیلرانی</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        roadsideServices.map((service) => (
          <a href={`/${service.slug}`} class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-success-300 hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-success-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-success-100 transition-colors">
              <span class="text-success-600 text-2xl font-bold">{service.persianName.charAt(0)}</span>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-success-600 transition-colors">{service.persianName}</h3>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{service.shortDesc}</p>
            <span class="text-sm text-success-600 font-medium group-hover:text-success-700">مشاهده خدمات →</span>
          </a>
        ))
      }
    </div>

    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 text-center mt-16">مناطق تحت پوشش</h2>
    <p class="text-gray-600 text-center mb-10">خدمات تعمیراتی و امدادی در شهرهای زیر ارائه می‌شود</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {
        locations.map((loc) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6 text-center hover:shadow-md transition-shadow">
            <h3 class="font-bold text-gray-900 mb-1">{loc.name}</h3>
            <p class="text-xs text-gray-500">{loc.neighborhoods.length} محله تحت پوشش</p>
          </div>
        ))
      }
    </div>

    <PhoneCTA />

    <section class="prose prose-rtl max-w-none mt-16">
      <h2>درباره تعمیر پاکدشت</h2>
      <p>
        تعمیر پاکدشت با بیش از ۱۵ سال تجربه در زمینه تعمیر لوازم خانگی و خدمات امداد خودرو، یکی از معتبرترین مراکز خدمات فنی در منطقه پاکدشت و شهرهای اطراف است. مدیریت این مجموعه بر عهده آقای خسروبیگی است که با نظارت مستقیم بر کیفیت خدمات، رضایت مشتریان را در اولویت قرار داده است.
      </p>
      <p>
        ما با تیمی از تکنسین‌های متخصص و آموزش‌دیده، خدمات تعمیر یخچال، لباسشویی، کولر گازی، پکیج و اجاق گاز را در تمام برندهای ایرانی و خارجی با گارانتی کتبی ارائه می‌دهیم. همچنین خدمات امداد خودرو شامل یدک کش، مکانیک سیار و خودروبر با مجوز رسمی از کانون جهانگردی و اتومبیلرانی و پوشش ۲۴ ساعته ارائه می‌شود.
      </p>
      <p>
        برای تماس و درخواست خدمات، با شماره <a href="tel:09032486073" dir="ltr">09032486073</a> تماس بگیرید. تیم ما در کوتاه‌ترین زمان به محل شما اعزام می‌شود.
      </p>
    </section>
  </div>
</Layout>
