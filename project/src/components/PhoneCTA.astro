---
export interface Props {
  title?: string;
  subtitle?: string;
  phone?: string;
}

const { title = 'نیاز به تعمیرکار دارید؟', subtitle = 'همین حالا تماس بگیرید — خدمات ۲۴ ساعته', phone = '09032486073' } = Astro.props as Props;
---

<section class="bg-gradient-to-l from-brand-600 to-brand-800 text-white rounded-2xl p-8 text-center my-8">
  <h2 class="text-2xl font-bold mb-2">{title}</h2>
  <p class="text-brand-100 mb-6">{subtitle}</p>
  <a
    href={`tel:${phone}`}
    class="inline-flex items-center gap-3 bg-white text-brand-700 font-bold text-lg px-8 py-4 rounded-xl hover:bg-brand-50 transition-colors shadow-lg"
    dir="ltr"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    {phone}
  </a>
</section>
