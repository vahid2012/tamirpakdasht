---
export interface BreadcrumbItem {
  name: string;
  url?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props as Props;
---

<nav class="text-sm text-gray-500 mb-6 flex items-center flex-wrap gap-1" aria-label="مسیر سایت">
  <a href="/" class="hover:text-brand-600 transition-colors">خانه</a>
  {
    items.map((item) => (
      <>
        <span class="text-gray-400">›</span>
        {item.url ? (
          <a href={item.url} class="hover:text-brand-600 transition-colors">{item.name}</a>
        ) : (
          <span class="text-gray-700 font-medium">{item.name}</span>
        )}
      </>
    ))
  }
</nav>
