---
const footerLinks = [
  {
    title: 'تعمیر لوازم خانگی',
    links: [
      { href: '/تعمیر-یخچال', label: 'تعمیر یخچال' },
      { href: '/تعمیر-لباسشویی', label: 'تعمیر لباسشویی' },
      { href: '/تعمیر-کولر-گازی', label: 'تعمیر کولر گازی' },
      { href: '/تعمیر-پکیج', label: 'تعمیر پکیج' },
      { href: '/تعمیر-اجاق-گاز', label: 'تعمیر اجاق گاز' },
    ],
  },
  {
    title: 'امداد خودرو',
    links: [
      { href: '/یدک-کش', label: 'یدک کش' },
      { href: '/مکانیک-سیار', label: 'مکانیک سیار' },
      { href: '/خودروبر', label: 'خودروبر' },
    ],
  },
  {
    title: 'مناطق تحت پوشش',
    links: [
      { href: '/تعمیر-یخچال-پاکدشت', label: 'تعمیر یخچال پاکدشت' },
      { href: '/یدک-کش-قرچک', label: 'یدک کش قرچک' },
      { href: '/تعمیر-لباسشویی-ورامین', label: 'تعمیر لباسشویی ورامین' },
      { href: '/مکانیک-سیار-پاکدشت', label: 'مکانیک سیار پاکدشت' },
      { href: '/خودروبر-تهران', label: 'خودروبر تهران' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="text-white font-bold text-lg mb-4">تعمیر پاکدشت</h3>
        <p class="text-sm leading-relaxed text-gray-400">
          مرکز تخصصی تعمیر لوازم خانگی و امداد خودرو در پاکدشت و شهرهای اطراف با بیش از ۱۵ سال تجربه و خدمات ۲۴ ساعته.
        </p>
        <div class="mt-4">
          <p class="text-sm text-gray-400">مدیریت: آقای خسروبیگی</p>
          <a
            href="tel:09032486073"
            class="inline-flex items-center gap-2 mt-2 bg-success-600 hover:bg-success-700 text-white font-bold px-4 py-2 rounded-lg transition-colors text-sm"
            dir="ltr"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            09032486073
          </a>
        </div>
      </div>

      {
        footerLinks.map((section) => (
          <div>
            <h3 class="text-white font-semibold text-sm mb-4">{section.title}</h3>
            <ul class="space-y-2">
              {section.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-gray-400 hover:text-brand-400 transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">
        © {year} تعمیر پاکدشت — تمام حقوق محفوظ است. <a href="/درباره-ما" class="hover:text-gray-300 transition-colors">درباره ما</a>
      </p>
      <p class="text-xs text-gray-500">
        مدیریت: آقای خسروبیگی —
        <a href="tel:09032486073" class="text-success-400 hover:text-success-300 font-medium" dir="ltr">09032486073</a>
      </p>
    </div>
  </div>
</footer>
